# EOL 约定：入库统一 LF（跨平台协作基线；单机 autocrlf 下工作区仍按平台转换）
* text=auto

# 文本类显式声明（代码/脚本/文档）
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制（模型/图片/视频/压缩包）
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.safetensors binary
*.gguf binary
*.bin binary
*.zip binary
*.7z binary
*.exe binary
